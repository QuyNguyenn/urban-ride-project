{
  "name": "urban-ride-project-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run validate && vite --host 127.0.0.1",
    "validate": "node scripts/validate.mjs",
    "test:validation": "node --test scripts/validate.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run validate && npm run test:validation && npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
